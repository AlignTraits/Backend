<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body style="margin:0;padding:24px;background:#f2f5f9;font-family:Arial,Helvetica,sans-serif;color:#002650;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #dbe4ee;border-radius:12px;">
    <tr>
      <td style="padding:24px 28px;border-bottom:1px solid #dbe4ee;">
        <p style="margin:0;font-size:12px;color:#33669d;">aligntraits.com website form</p>
        <h1 style="margin:6px 0 0;font-size:20px;color:#004085;"><%= title %></h1>
      </td>
    </tr>
    <tr>
      <td style="padding:12px 28px 24px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
          <% rows.forEach(function (row) { %>
          <tr>
            <td style="padding:10px 12px 10px 0;border-bottom:1px solid #eef2f7;font-size:13px;color:#33669d;vertical-align:top;width:38%;"><%= row[0] %></td>
            <td style="padding:10px 0;border-bottom:1px solid #eef2f7;font-size:14px;color:#002650;vertical-align:top;"><%= row[1] %></td>
          </tr>
          <% }) %>
        </table>
        <p style="margin:20px 0 0;font-size:12px;color:#33669d;">This includes personal details. Do not forward it outside the AlignTraits team.</p>
      </td>
    </tr>
  </table>
</body>
</html>
