<!-- views/email-template.ejs -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to AlignTraits - Your Waitlist Spot is Secured!</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            margin: 0;
            padding: 0;
        }

        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #001833;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            border: 2px solid #1565C0;
        }

        .logo {
            text-align: center;
            margin-bottom: 20px;
        }

        .logo img {
            max-width: 250px;
        }

        .content {
            text-align: left;
        }

        .content h1 {
            color: #ffffff;
            /* color: #1565C0; */
            font-size: 24px;
            margin-bottom: 20px;
        }

        .content p {
            color: #ffffff;
            /* color: #333333; */
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .button-wrapper {
            text-align: center;
            margin-bottom: 20px;
        }

        .button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #1565C0;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 5px;
            font-size: 16px;
            margin-bottom: 20px;
            text-align: center !important;
        }

        .footer {
            text-align: left;
            font-size: 14px;
            color: #ffffff;
            /* color: #666666; */
            margin-top: 30px;
        }

        .footer a {
            color: #ffffff;
            /* color: #1565C0; */
            text-decoration: none;
        }

        .social-icons {
            text-align: right;
        }

        .social-icons img {
            max-width: 25px;
            margin: 0 10px;
        }
    </style>
</head>

<body>
    <div class="email-container">
        <div class="logo">
            <img src="<%= host %>/assets/full-logo.png" alt="AlignTraits Logo">
        </div>
        <div class="content">
            <!-- <h1>Welcome to AlignTraits - Your Waitlist Spot is Secured!</h1> -->
            <p><b>Hi <%= email %>,</b></p>
            <p>
                Thank you for joining the waitlist for AlignTraits, the platform that brings personalized career
                recommendations based on your unique personality traits. Your spot on the waitlist is officially
                secured.
            </p>
            <p> We're currently in a private alpha and onboarding new users in batches every week.</p>
            <p> If you want early access, simply reply to this email with "Interested!"</p>
            <p>
                Thank you,
                The AlignTraits Team</p>
        </div>
        <div class="footer">
            <!-- <p>P.S. Stay updated on features and career insights by following us on</p>
            <div class="social-icons">
                <a href="#"><img src="<%= host %>/assets/instagram-icon.png" alt="Instagram"></a>
                <a href="#"><img src="<%= host %>/assets/facebook-icon.png" alt="Facebook"></a>
                <a href="#"><img src="<%= host %>/assets/linkedin-icon.png" alt="LinkedIn"></a>
            </div> -->
        </div>
    </div>
</body>

</html>