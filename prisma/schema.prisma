// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// this shouldn't affect you techbro - change it has much as you like 
enum Roles {
  ADMIN
  USER
  COMMUNITY
}

model User {
  id        String   @id @default(cuid())
  username  String?
  email     String   @unique
  password  String
  role      Roles    @default(USER)
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
}
