// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Roles {
  ADMIN
  USER
  SUPER_ADMIN
  CONTENT_MANAGER
  ANALYST
}

enum Gender {
  MALE
  FEMALE
}

// enum AgeRange {
//   // 1624
// }

// Enum for payment plans
enum PaymentPlan {
  BASIC_ONETIME
  LOCAL_MONTHLY
  GLOBAL_MONTHLY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}


model AcademicRecord {
  id                     String   @id @default(cuid())
  userId                 String
  ExamCountry1           String?  @map("ExamCountry1")
  ExamType1              String?  @map("ExamType1")
  ExamType1Subjects      String?  @map("ExamType1Subjects")
  ExamType1SubGrades     String?  @map("ExamType1SubGrades")

  ExamCountry2           String?  @map("ExamCountry2")
  ExamType2              String?  @map("ExamType2")
  ExamType2Subjects      String?  @map("ExamType2Subjects")
  ExamType2SubGrades     String?  @map("ExamType2SubGrades")

  ExamCountry3           String?  @map("ExamCountry3")
  ExamType3              String?  @map("ExamType3")
  ExamType3Subjects      String?  @map("ExamType3Subjects")
  ExamType3SubGrades     String?  @map("ExamType3SubGrades")

  ExamCountry4           String?  @map("ExamCountry4")
  ExamType4              String?  @map("ExamType4")
  ExamType4Subjects      String?  @map("ExamType4Subjects")
  ExamType4SubGrades     String?  @map("ExamType4SubGrades")

  ExamCountry5           String?  @map("ExamCountry5")
  ExamType5              String?  @map("ExamType5")
  ExamType5Subjects      String?  @map("ExamType5Subjects")
  ExamType5SubGrades     String?  @map("ExamType5SubGrades")

  ExamCountry6           String?  @map("ExamCountry6")
  ExamType6              String?  @map("ExamType6")
  ExamType6Subjects      String?  @map("ExamType6Subjects")
  ExamType6SubGrades     String?  @map("ExamType6SubGrades")

  ExamCountry7           String?  @map("ExamCountry7")
  ExamType7              String?  @map("ExamType7")
  ExamType7Subjects      String?  @map("ExamType7Subjects")
  ExamType7SubGrades     String?  @map("ExamType7SubGrades")

  ExamCountry8           String?  @map("ExamCountry8")
  ExamType8              String?  @map("ExamType8")
  ExamType8Subjects      String?  @map("ExamType8Subjects")
  ExamType8SubGrades     String?  @map("ExamType8SubGrades")

  ExamCountry9           String?  @map("ExamCountry9")
  ExamType9              String?  @map("ExamType9")
  ExamType9Subjects      String?  @map("ExamType9Subjects")
  ExamType9SubGrades     String?  @map("ExamType9SubGrades")

  ExamCountry10          String?  @map("ExamCountry10")
  ExamType10             String?  @map("ExamType10")
  ExamType10Subjects     String?  @map("ExamType10Subjects")
  ExamType10SubGrades    String?  @map("ExamType10SubGrades")

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("academic_records")
}


model User {
  id                      String              @id @default(cuid())
  firstname               String
  lastname                String
  username                String?
  email                   String              @unique
  emailVerified           DateTime?
  password                String
  role                    Roles               @default(USER)
  contactNumber           String?
  createdAt               DateTime            @default(now())
  gender                  Gender?
  dob                     DateTime?
  ageRange                String?
  region                  String?
  bio                     String?
  image                   String?
  updatedAt               DateTime?           @updatedAt
  otherSkill              String?
  payment_plan            PaymentPlan?
  payment_plan_expires_at DateTime?
  subscription_code       String?             // Paystack subscription code for auto-renewal
  email_token             String?             // Customer email token for subscription management
  default_authorization   String?             // Default authorization code for the user's card
  actionHistories         ActionHistory[]
  isCareerPathChecked  Boolean  @default(false)
  careerResults           CareerResult?
  eligibilityResults      EligibilityResult[]
  ResultDocument          ResultDocument[]
  transactions            Transaction[]
  UserResponse            UserResponse[]
  interests               Interest[]          @relation("UserInterests")
  skills                  Skill[]             @relation("UserSkills")
  userCards               UserCard[]          // Link to user's cards
  userDirectDebits UserDirectDebit[]
  academicRecords AcademicRecord[]
}


model Transaction {
  id             String           @id @default(cuid())
  userId         String
  paymentPlan    PaymentPlan
  amount         Float
  currency       String
  reference      String           @unique
  status         TransactionStatus @default(PENDING)
  schoolLocation String?          // Add this field
  createdAt      DateTime         @default(now())
  updatedAt      DateTime?        @updatedAt
  user           User             @relation(fields: [userId], references: [id])
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
}

model UserCard {
  id                 String    @id @default(cuid())
  userId             String
  authorization_code String    @unique
  last4              String
  exp_month          String
  exp_year           String
  brand              String
  reusable           Boolean

  subscription_status SubscriptionStatus? // 'active', 'expired', etc.

  subscription_code  String?   // Add this for redundancy
  email_token        String?   // Add this for redundancy
  next_payment_date  DateTime? // Add this for tracking

  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt
  user               User      @relation(fields: [userId], references: [id])
}

model UserDirectDebit {
  id                String      @id @default(uuid())
  userId            String
  authorization_code String     @unique
  bank_code         String
  account_number    String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


model EligibilityResult {
  id                     String           @id @default(cuid())
  user                   User             @relation(fields: [userId], references: [id])
  userId                 String
  results                Json[]         

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model CareerResult {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  recommendedCareers String[]
  richRecommendations String? @db.Text // ← New field to store full JSON
  recommendedCourses Json?   // Optional JSON array of { id: string, title: string }
  reasoning         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model City {
  id        String  @id @default(uuid())
  name      String
  country   Country @relation(fields: [countryId], references: [id])
  countryId String
  // users    User[]
}

model Country {
  id     String @id @default(uuid())
  name   String
  cities City[]
}

model Skill {
  id    String @id @default(uuid())
  name  String
  users User[] @relation("UserSkills")
}

model Interest {
  id    String @id @default(uuid())
  name  String
  users User[] @relation("UserInterests")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ResultDocument {
  id        String   @id @default(cuid())
  userId    String // Foreign key to User
  user      User     @relation(fields: [userId], references: [id])
  fileName  String // e.g., 'Akinola Oluwatosin WAEC 2023 Result.PDF'
  fileUrl   String // URL pointing to the uploaded file
  fileSize  Int // Size of the file in KB
  fileType  String   @default("PDF") // Type of the uploaded file, defaulted to 'PDF'
  createdAt DateTime @default(now())
}

model Survey {
  id          String          @id @default(uuid())
  name        String
  description String?
  sections    SurveySection[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SurveySection {
  id        Int     @id @default(autoincrement())
  name      String
  survey    Survey     @relation(fields: [surveyId], references: [id])
  surveyId  String
  questions Question[]
  createdAt DateTime   @default(now())
}

model Question {
  id           String         @id @default(uuid())
  text         String
  section      SurveySection  @relation(fields: [sectionId], references: [id])
  sectionId    Int
  createdAt    DateTime       @default(now())
  AnswerOption AnswerOption[]
  UserResponse UserResponse[]
}

model AnswerOption {
  id           String         @id @default(uuid())
  questionId   String         @unique
  text         String
  isNotSure    Boolean        @default(false)
  UserResponse UserResponse[]
  question     Question       @relation(fields: [questionId], references: [id])
}

model UserResponse {
  id               String       @id @default(uuid())
  user             User         @relation(fields: [userId], references: [id])
  userId           String
  question         Question     @relation(fields: [questionId], references: [id])
  questionId       String
  selectedOption   AnswerOption @relation(fields: [selectedOptionId], references: [id])
  selectedOptionId String
  createdAt        DateTime     @default(now())
}

model WaitList {
  id             String           @id @default(uuid())
  email          String           @unique
  createdAt      DateTime         @default(now())
}

model School {
  id                     String          @id @default(dbgenerated("substring(gen_random_uuid()::text, 1, 10)"))
  name                   String    @unique
  schoolType             SchoolType
  country                String    // Replacing location with country
  region                 String 
  logo                   String?
  websiteUrl             String
  courses                Course[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
}


model ActionHistory {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityIds Json
  metadata  Json?    // <-- Add this line
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  timestamp DateTime @default(now())
}


enum SchoolType {
  FEDERAL_UNIVERSITY
  PRIVATE_UNIVERSITY
  PUBLIC_UNIVERSITY
}



// Enums for Exam Type and Grade
enum ExamType {
  JAMB
  UTME
  NECO
  GCE
  WAEC
  NABTEB
  A_LEVEL
}

enum Grade {
  A1
  B2
  B3
  C4
  C5
  C6
  D7
  E8
  F9
}

enum DurationPeriod {
  YEARS
  MONTHS
  WEEKS
  Years
  years
  Weeks
  weeks
  Months
  months
}

enum Currency {
  USD
  EUR
  NGN // Add other currencies as needed
  CAD
}

model CourseCategory {
  id      Int      @id @default(autoincrement())
  name    String
  courses Course[] @relation("CourseCategoryCourses")
}

model Course {
  id                     String          @id @default(dbgenerated("substring(gen_random_uuid()::text, 1, 10)"))
  title                  String          // Course Title
  image                  String?         // Course Image
  schoolId               String          // Program Location (via relation to School)
  university             School          @relation(fields: [schoolId], references: [id])
  scholarship            String          // Scholarship
  scholarshipInformation String?         // Scholarship Information
  duration               Int             // Program Duration (e.g., 4)
  durationPeriod         DurationPeriod  // Program Duration (e.g., YEARS)
  programLevel           String          // Program Level (Bachelor Degree, Masters Degree, PGD)
  price                  Float           // Course Price
  currency               Currency        // Currency for Course Price
  acceptanceFee          Float           // Acceptance Fee
  acceptanceFeeCurrency  Currency        // Currency for Acceptance Fee
  objectives             String?          // Course Objectives
  courseWebsiteUrl       String?          // Course website url
  loanInformation        String?          // Loan Information
  ratings                Float?          @default(0.0) // Optional ratings field with default

  // Admission Logic (Optional)
  ExamCountry1           String?         // Country for first exam requirement (e.g., "Nigeria")
  ExamType1             String?         // Exam type for first requirement (e.g., "WAEC")
  ExamType1Subjects     String?         // JSON string of subjects (e.g., "[\"Math\", \"English\"]")
  ExamType1SubGrades    String?         // JSON string of grades (e.g., "[\"A1\", \"B2\"]")

  ExamCountry2           String?
  ExamType2             String?
  ExamType2Subjects     String?
  ExamType2SubGrades    String?

  ExamCountry3           String?
  ExamType3             String?
  ExamType3Subjects     String?
  ExamType3SubGrades    String?

  ExamCountry4           String?
  ExamType4             String?
  ExamType4Subjects     String?
  ExamType4SubGrades    String?

  ExamCountry5           String?
  ExamType5             String?
  ExamType5Subjects     String?
  ExamType5SubGrades    String?

  ExamCountry6           String?
  ExamType6             String?
  ExamType6Subjects     String?
  ExamType6SubGrades    String?

  ExamCountry7           String?
  ExamType7             String?
  ExamType7Subjects     String?
  ExamType7SubGrades    String?

  ExamCountry8           String?
  ExamType8             String?
  ExamType8Subjects     String?
  ExamType8SubGrades    String?

  ExamCountry9           String?
  ExamType9             String?
  ExamType9Subjects     String?
  ExamType9SubGrades    String?

  ExamCountry10          String?
  ExamType10            String?
  ExamType10Subjects    String?
  ExamType10SubGrades   String?

  Adminrule1            String?         // e.g., "WAEC"
  Adminrule2            String?         // e.g., "WAEC | NECO"
  Adminrule3            String?         // e.g., "WAEC + NECO"
  Adminrule4            String?         // e.g., "WAEC + NECO | JAMB"
  Adminrule5            String?         // e.g., "WAEC + NECO | JAMB + GCE"
  
  jambCutOffMark        Float?        @default(0)
  // End of Admission Logic (Optional)

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt

  categoryId             Int?
  category               CourseCategory? @relation("CourseCategoryCourses", fields: [categoryId], references: [id])
}

model BulkOperationFailure {
  id           String   @id @default(cuid())
  entity       String   // e.g., "Course" or "School"
  operation    String   // e.g., "Create" or "Update"
  itemData     Json     // The failed item's data (e.g., the course or school object)
  errorMessage String   // The specific error message for this failure
  createdAt    DateTime @default(now())
}

