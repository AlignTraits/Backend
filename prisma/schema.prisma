// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Roles {
  ADMIN
  USER
  SUPER_ADMIN
  CONTENT_MANAGER
  ANALYST
}

enum Gender {
  MALE
  FEMALE
}

// enum AgeRange {
//   // 1624
// }

model User {
  id             String           @id @default(cuid())
  firstname      String
  lastname       String
  username       String?
  email          String           @unique
  emailVerified  DateTime?
  password       String
  role           Roles            @default(USER)
  contactNumber  String?          // New field: Optional contact number
  createdAt      DateTime         @default(now())
  gender         Gender?
  dob            DateTime?
  ageRange       String?
  region         String?
  bio            String?
  image          String?
  updatedAt      DateTime?        @updatedAt
  // cityId         String?
  // city           City?     @relation(fields: [cityId], references: [id])
  otherSkill     String?          // New optional field for custom skill
  skills         Skill[]          @relation("UserSkills")
  interests      Interest[]       @relation("UserInterests")
  ResultDocument ResultDocument[]
  UserResponse   UserResponse[]
  actionHistories ActionHistory[]
}

model City {
  id        String  @id @default(uuid())
  name      String
  country   Country @relation(fields: [countryId], references: [id])
  countryId String
  // users    User[]
}

model Country {
  id     String @id @default(uuid())
  name   String
  cities City[]
}

model Skill {
  id    String @id @default(uuid())
  name  String
  users User[] @relation("UserSkills")
}

model Interest {
  id    String @id @default(uuid())
  name  String
  users User[] @relation("UserInterests")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ResultDocument {
  id        String   @id @default(cuid())
  userId    String // Foreign key to User
  user      User     @relation(fields: [userId], references: [id])
  fileName  String // e.g., 'Akinola Oluwatosin WAEC 2023 Result.PDF'
  fileUrl   String // URL pointing to the uploaded file
  fileSize  Int // Size of the file in KB
  fileType  String   @default("PDF") // Type of the uploaded file, defaulted to 'PDF'
  createdAt DateTime @default(now())
}

model Survey {
  id          String          @id @default(uuid())
  name        String
  description String?
  sections    SurveySection[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SurveySection {
  id        Int     @id @default(autoincrement())
  name      String
  survey    Survey     @relation(fields: [surveyId], references: [id])
  surveyId  String
  questions Question[]
  createdAt DateTime   @default(now())
}

model Question {
  id           String         @id @default(uuid())
  text         String
  section      SurveySection  @relation(fields: [sectionId], references: [id])
  sectionId    Int
  createdAt    DateTime       @default(now())
  AnswerOption AnswerOption[]
  UserResponse UserResponse[]
}

model AnswerOption {
  id           String         @id @default(uuid())
  questionId   String         @unique
  text         String
  isNotSure    Boolean        @default(false)
  UserResponse UserResponse[]
  question     Question       @relation(fields: [questionId], references: [id])
}

model UserResponse {
  id               String       @id @default(uuid())
  user             User         @relation(fields: [userId], references: [id])
  userId           String
  question         Question     @relation(fields: [questionId], references: [id])
  questionId       String
  selectedOption   AnswerOption @relation(fields: [selectedOptionId], references: [id])
  selectedOptionId String
  createdAt        DateTime     @default(now())
}

model WaitList {
  id             String           @id @default(uuid())
  email          String           @unique
  createdAt      DateTime         @default(now())
}

model School {
  id                     String          @id @default(dbgenerated("substring(gen_random_uuid()::text, 1, 10)"))
  name                   String
  schoolType             SchoolType
  country                String    // Replacing location with country
  region                 String 
  logo                   String?
  websiteUrl             String
  courses                Course[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
}


model ActionHistory {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityIds Json
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  timestamp DateTime @default(now())
}


enum SchoolType {
  FEDERAL_UNIVERSITY
  PRIVATE_UNIVERSITY
  PUBLIC_UNIVERSITY
}



// Enums for Exam Type and Grade
enum ExamType {
  JAMB
  UTME
  NECO
  GCE
  WAEC
  NABTEB
  A_LEVEL
}

enum Grade {
  A1
  B2
  B3
  C4
  C5
  C6
  D7
  E8
  F9
}

enum DurationPeriod {
  YEARS
  MONTHS
  WEEKS
}

enum Currency {
  USD
  EUR
  NGN // Add other currencies as needed
  CAD
}

model Course {
  id                     String          @id @default(dbgenerated("substring(gen_random_uuid()::text, 1, 10)"))
  title                  String          // Course Title
  image                  String?         // Course Image
  schoolId               String          // Program Location (via relation to School)
  university             School          @relation(fields: [schoolId], references: [id])
  programLocation        String          // New field for Program Location
  scholarship            String          // Scholarship
  scholarshipRequirement String?         // Scholarship Requirement
  duration               Int             // Program Duration (e.g., 4)
  durationPeriod         DurationPeriod  // Program Duration (e.g., YEARS)
  programLevel           String          // Program Level (Bachelor Degree, Masters Degree, PGD)
  price                  Float           // Course Price
  currency               Currency        // Currency for Course Price
  acceptanceFee          Float           // Acceptance Fee
  acceptanceFeeCurrency  Currency        // Currency for Acceptance Fee
  objectives             String          // Course Objectives
  courseWebsiteUrl       String          // Course website url
  loanInformation        String          // Loan Information
  examTypes              ExamType[]      // Exam Type
  examYear               Int?            // Exam Year
  subjects               String[]        // Subjects
  grades                 Grade[]         // Grade
  ratings                Float           @default(0.0) // Reintroduced ratings field
  ruleName               String?         // Admission Rule Name
  ruleDescription        String?         // Admission Rule Description
  ruleRequiredExams      String?        
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
}

model BulkOperationFailure {
  id           String   @id @default(cuid())
  entity       String   // e.g., "Course" or "School"
  operation    String   // e.g., "Create" or "Update"
  itemData     Json     // The failed item's data (e.g., the course or school object)
  errorMessage String   // The specific error message for this failure
  createdAt    DateTime @default(now())
}