// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum Roles {
  ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
}

// enum AgeRange {
//   // 1624
// }

model User {
  id             String   @id @default(cuid())
  firstname      String
  lastname       String
  email          String   @unique
  emailVerified  DateTime?
  password       String
  role           Roles    @default(USER)
  createdAt      DateTime @default(now())
  gender         Gender?
  dob            DateTime?
  ageRange       String?
  region         String?
  bio            String?
  image          String?
  updatedAt      DateTime?  @updatedAt
  // cityId         String?
  // city           City?     @relation(fields: [cityId], references: [id])
  skills         Skill[]   @relation("UserSkills")
  interests      Interest[] @relation("UserInterests")
}

model City {
  id       String   @id @default(uuid())
  name     String
  country  Country  @relation(fields: [countryId], references: [id])
  countryId String
  // users    User[]
}

model Country {
  id    String   @id @default(uuid())
  name  String
  cities City[]
}

model Skill {
  id    String   @id @default(uuid())
  name  String
  users User[]   @relation("UserSkills")
}

model Interest {
  id    String   @id @default(uuid())
  name  String
  users User[]   @relation("UserInterests")
}


model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
}